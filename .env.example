# Server .env template. Copy to .env and fill in. The real .env is never committed.

ANTHROPIC_API_KEY=
DATABASE_URL=postgres://app:app_local_dev_pw@localhost:5432/advisor
MIGRATOR_DATABASE_URL=postgres://migrator:migrator_local_dev_pw@localhost:5432/advisor
APP_BASE_URL=https://advisor.internal.clinicmind.example
SESSION_SECRET=
MODEL_COMPOSER=claude-sonnet-5
MODEL_VERIFIER=claude-sonnet-5
MODEL_LIGHT=claude-haiku-4-5-20251001
EMBEDDING_MODEL=            # local model id chosen in Phase 2; baked into images
RERANK_MODEL=               # local cross-encoder chosen in Phase 2; baked into images
CPT_LICENSE_MODE=none       # none | licensed
CPT_DATA_FILE_PATH=
PHI_MODE=deny               # deny | allow
REMIT_MIN_N=30
REMIT_835_ENABLED=0
AUTH_GOOGLE_ENABLED=0
DAILY_COST_CAP_USD=25
DEFAULT_TZ=America/New_York
DEFAULT_PAYER=Medicare Part B
BACKUP_TARGET=              # path or mount for nightly encrypted backups
RUN_INTEGRATION=0

# Local development and build additions (documented in docs/DECISIONS.md)
EMBEDDING_DIM=768           # vector dimension; final value set in Phase 2 (D4)
CMS_LICENSE_ATTESTATION=accept # accept | refuse; CMS end-user license click-through (D7)
LLM_MODE=                   # live | stub; empty means live when a key is present (D1)
ARTIFACTS_DIR=./artifacts   # raw fetched artifacts with SHA-256 names
APP_PORT=3000
# Passwords used by deploy/initdb/01-roles.sql when the compose db first initializes
POSTGRES_SUPER_PASSWORD=postgres_local_dev_pw
DB_MIGRATOR_PASSWORD=migrator_local_dev_pw
DB_APP_PASSWORD=app_local_dev_pw
